{
	"name": "prestashop-webservice-relay-mcp",
	"version": "0.1.0",
	"description": "MCP relay server for PrestaShop Webservice v1.7+.",
	"files": [
		"dist"
	],
	"bin": {
		"prestashop-webservice-relay-mcp": "./dist/index.js"
	},
	"exports": "./dist/index.js",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.8",
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --target=node --format=esm --packages=external --outfile=dist/index.js && chmod +x dist/index.js",
		"start": "bun run index.ts",
		"start:http": "bun run index.ts --transport http",
		"dev": "bun run index.ts",
		"format": "bunx biome format --write .",
		"format:check": "bunx biome format .",
		"check": "bunx biome check .",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "tsc --noEmit",
		"precommit": "bun run check && bun run typecheck && bun run test",
		"prepack": "bun run build",
		"release:pack": "npm pack --dry-run",
		"release:publish": "npm publish --access public",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/bun": "latest",
		"@types/node": "^25.9.1",
		"husky": "^9.1.7",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"fast-xml-parser": "^5.8.0",
		"zod": "^4.4.3"
	}
}
